# Maintainer: devansh choubey <devanshc13 at gmail dot com>
# Binary package: installs the static musl release tarball (no Rust needed).
pkgname=shelllint-bin
pkgver=0.2.1
pkgrel=1
pkgdesc="A Rust port of ShellCheck: finds bugs in shell scripts (prebuilt static binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/DevanshChoubey/shelllint"
license=('GPL-3.0-or-later')
provides=('shelllint')
conflicts=('shelllint')
options=('!strip')
source_x86_64=("$url/releases/download/v$pkgver/shelllint-v$pkgver-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/shelllint-v$pkgver-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('@SHA256_X86_64_LINUX@')
sha256sums_aarch64=('@SHA256_AARCH64_LINUX@')

package() {
  install -Dm755 shelllint "$pkgdir/usr/bin/shelllint"
}
